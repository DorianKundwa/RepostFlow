# ============================================================
# RepostFlow - Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Flask Core ---
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# SQLite (default local):
DATABASE_URL=sqlite:///instance/repostflow.db
# PostgreSQL (future VPS):
# DATABASE_URL=postgresql://user:password@host:5432/repostflow

# --- Google OAuth 2.0 ---
# Path to your downloaded OAuth 2.0 client secrets JSON from Google Cloud Console.
GOOGLE_CLIENT_SECRETS_FILE=storage/credentials/client_secrets.json

# The redirect URI must exactly match what you registered in Google Cloud Console.
# Local development:
OAUTH_REDIRECT_URI=http://localhost:5000/oauth/callback

# --- Token Encryption ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This key encrypts OAuth tokens stored in the database.
# If you lose this key you will need to re-authorise all channels.
TOKEN_ENCRYPTION_KEY=change-me-to-a-fernet-key

# --- Application Settings ---
# Max concurrent upload workers
MAX_CONCURRENT_UPLOADS=2

# Default upload privacy: private | unlisted | public
DEFAULT_PRIVACY=private

# How often to check YouTube source channels (seconds)
YOUTUBE_POLL_INTERVAL=300

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Flask Environment ---
FLASK_ENV=development
FLASK_DEBUG=0
