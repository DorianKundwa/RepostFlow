# ============================================================
# RepostFlow - .gitignore
# ============================================================

# --- Secrets and credentials (NEVER commit these) ---
.env
storage/credentials/
instance/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- IDE and editors ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs ---
logs/*.log
logs/*.log.*

# --- Media storage ---
storage/videos/
storage/thumbnails/
storage/temp/
storage/backups/

# --- SQLite database ---
*.db
*.sqlite3

# --- Test artifacts ---
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# --- Distribution ---
dist/
build/
